# Copy to .env and fill in. Real environment variables take precedence over .env.

# Base URL of the OpenAI-compatible API (the part before /chat/completions)
SPLUNK_Q_API_BASE_URL=https://your-llm-host.example.com/v1

# Bearer token (leave empty if your endpoint needs no auth)
SPLUNK_Q_API_KEY=

# Model name as your server expects it
SPLUNK_Q_MODEL=llama-4-maverick
# SPLUNK_Q_MODEL=gpt-oss-120b

# Optional
# SPLUNK_Q_TEMPERATURE=0.1
# SPLUNK_Q_MAX_TOKENS=2048
# SPLUNK_Q_REASONING_EFFORT=medium   # only send for gpt-oss / reasoning models
# SPLUNK_Q_TIMEOUT_MS=120000
